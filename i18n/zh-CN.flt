# Hodor CLI messages (zh-CN). Keep keys in sync with en-US.flt.

app-about = Hodor — 守住 AI agent 与你的密钥之间的那扇门。
vault-title = Hodor 保险库
vault-created = 保险库已创建:{ $path }
vault-exists = { $path } 已存在保险库;用 `hodor unlock` 测试
vault-missing = { $path } 未找到保险库;请先执行 `hodor init`
passphrase-new = 设置主口令(至少 8 位,不要与 sudo/登录密码相同)
passphrase-confirm = 确认主口令
passphrase-prompt = 输入主口令以解锁保险库
passphrase-mismatch = 两次输入的口令不一致
passphrase-too-short = 口令至少需要 8 个字符
anti-phish-prompt = 设定反钓鱼短语(每个合法的 Hodor 弹窗都会显示它)
anti-phish-shown = 反钓鱼短语:{ $phrase }(请记住;不显示该短语的弹窗即为伪造)
unlock-ok = 保险库已解锁:{ $count } 个对象,链头 { $head }
unlock-failed = 解锁失败:口令错误或保险库损坏
lock-note = CLI 进程退出时密钥即清零;常驻锁定由 daemon(M2)提供
presence-start = 请触摸指纹识别器以确认本人在场...
presence-ok = 已确认在场
presence-failed = 在场确认失败
presence-unavailable = 指纹验证不可用:{ $reason }
add-value-prompt = 输入 "{ $alias }" 的密钥值
add-value-again = 再次输入 "{ $alias }" 的密钥值
add-value-mismatch = 两次输入不一致
object-added = 对象 "{ $alias }"({ $kind })已存入
object-exists = 别名 "{ $alias }" 已存在;请先 revoke 或换一个别名
alias-missing = 不存在别名为 "{ $alias }" 的对象
object-revoked = 对象 "{ $alias }" 已移除
policy-updated = "{ $alias }" 的策略已更新
policy-unknown-kind = 未知的确认模式 "{ $value }"(可选:always、task、whitelisted)
audit-title = 审计日志
objects-title = 对象列表
audit-ok = 审计链校验通过:共 { $n } 条,链头 { $head }
audit-tampered = 审计链在第 { $seq } 条断裂:{ $field }
audit-head-mismatch = 日志止于 { $log_head },但库内链头为 { $vault_head };可能有记录被删除
run-denied = 硬黑名单拒绝({ $category });详见 `hodor audit`
run-unknown-alias = 命令引用了未知别名 "{ $alias }"
run-not-executable = 对象 "{ $alias }" 不允许用于命令执行(允许的用途:{ $uses })
run-status = 命令退出码:{ $code }
run-empty = 命令为空;用法:hodor run -- <含 {{alias}} 引用的命令>
canceled = 用户已取消
config-saved = 配置已保存至 { $path }
config-unknown-key = 未知配置项 "{ $key }"(可用:lang、require-presence、auto-lock-minutes、pinentry)
config-bad-value = 配置项 "{ $key }" 的值 "{ $value }" 无效
status-header = Hodor 状态
status-vault = 保险库:{ $path }
status-locked = 已锁定(静态时始终锁定)
status-objects = 解锁后可见 { $count } 个对象
status-config = 配置:语言={ $lang },指纹在场={ $presence }
no-input-tty = 无控制终端;请使用 `pinentry` 或在终端中运行
io-error = I/O 错误:{ $reason }
