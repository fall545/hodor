# Hodor CLI messages (en-US). Keep keys in sync with zh-CN.flt.

app-about = Hodor — hold the door between your AI agent and your secrets.
vault-title = Hodor vault
vault-created = Vault created at { $path }
vault-exists = A vault already exists at { $path }; use `hodor unlock` to test it
vault-missing = No vault found at { $path }; run `hodor init` first
passphrase-new = Set a master passphrase (min 8 chars, NOT your sudo/login password)
passphrase-confirm = Confirm master passphrase
passphrase-prompt = Enter master passphrase to unlock the vault
passphrase-mismatch = Passphrases do not match
passphrase-too-short = Passphrase must be at least 8 characters
anti-phish-prompt = Choose an anti-phishing phrase (shown in every legitimate Hodor dialog)
anti-phish-shown = Anti-phishing phrase: { $phrase } (memorize it; dialogs without it are fake)
unlock-ok = Vault unlocked: { $count } objects, chain head { $head }
unlock-failed = Unlock failed: wrong passphrase or corrupted vault
lock-note = CLI processes zeroize the key on exit; persistent locking arrives with the daemon (M2)
presence-start = Touch the fingerprint reader to confirm your presence...
presence-ok = Presence verified
presence-failed = Presence verification failed
presence-unavailable = Fingerprint verification unavailable: { $reason }
add-value-prompt = Enter the secret value for "{ $alias }"
add-value-again = Re-enter the secret value for "{ $alias }"
add-value-mismatch = Values do not match
object-added = Object "{ $alias }" ({ $kind }) stored
object-exists = Object "{ $alias }" already exists; revoke it first or pick another alias
alias-missing = No object with alias "{ $alias }"
object-revoked = Object "{ $alias }" revoked
policy-updated = Policy for "{ $alias }" updated
policy-unknown-kind = Unknown confirm mode "{ $value }" (expected: always, task, whitelisted)
audit-title = Audit log
objects-title = Objects
audit-ok = Audit chain verified: { $n } entries, head { $head }
audit-tampered = Audit chain BROKEN at entry { $seq }; first diverging field: { $field }
audit-head-mismatch = Log ends at { $log_head } but vault head is { $vault_head }; entries may be deleted
run-denied = Refused by hard blacklist ({ $category }); see `hodor audit`
run-unknown-alias = Command references unknown alias "{ $alias }"
run-not-executable = Object "{ $alias }" is not allowed for command execution (allowed uses: { $uses })
run-status = Command exited with code { $code }
run-empty = Empty command; usage: hodor run -- <command with {{alias}} refs>
canceled = Canceled by user
config-saved = Config saved to { $path }
config-unknown-key = Unknown config key "{ $key }" (expected: lang, require-presence, auto-lock-minutes, pinentry)
config-bad-value = Invalid value "{ $value }" for config key "{ $key }"
status-header = Hodor status
status-vault = Vault: { $path }
status-locked = Locked (at rest, always)
status-objects = { $count } object(s) after unlock
status-config = Config: lang={ $lang }, presence={ $presence }
no-input-tty = No controlling terminal; use `pinentry` or run from a terminal
io-error = I/O error: { $reason }
